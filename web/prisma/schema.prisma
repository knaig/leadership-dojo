datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// CORE IDENTITY & RBAC
// ============================================================================

enum Role {
  STUDENT
  MANAGER
  CURATOR
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  phoneNumber   String?
  countryCode   String    @default("+91")  // E.164 country prefix, default India
  role          Role      @default(STUDENT)

  // Hierarchy
  managerId String?
  manager   User?   @relation("Team", fields: [managerId], references: [id])
  reports   User[]  @relation("Team")

  // Account linking for NextAuth
  accounts Account[]
  sessions Session[]

  // Application Data
  progress    CaseProgress[]
  reflections Reflection[]

  // Agentic Data (New)
  skills   UserSkill[]
  recPlans RecPlan[]

  // Real World Context
  projects        UserProject[]    // Legacy — use unifiedProjects for new code
  unifiedProjects Project[]
  meetingLogs     MeetingLog[]
  missions        Mission[]

  // Subscription & Billing
  subscription Subscription?
  apiKeys      UserApiKey[]

  // Work Feedback System
  connectors        DataConnector[]
  workArtifacts     WorkArtifact[]
  skillObservations SkillObservation[]
  capacityScores    CapacityScore[]
  domainContext     DomainContext?
  stakeholders      StakeholderProfile[]
  feedbackItems     FeedbackItem[]
  learningRecs      LearningRecommendation[]
  actionPlans       UserActionPlan[]
  practiceMissions  PracticeMission[]


  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Antigravity: User Context
  jobTitle              String?                    // "VP Engineering"
  company               String?
  industry              String?
  companyStage          CompanyStage?
  onboardingComplete    Boolean   @default(false)
  
  businessContext       BusinessContext?
  
  // Antigravity: Relations
  decisions             Decision[]
  conversationPreps     ConversationPrep[]
  kpis                  UserKPI[]
  timeAllocations       TimeAllocation[]
  wastePatterns         WastePattern[]
  externalSignals       ExternalSignal[]
  assumptionReviews     AssumptionReview[]
  conversationInsights  ConversationInsight[]
  caseSurfacings        CaseSurfacing[]
  
  // Antigravity: Phase 2 Additions
  kpiActions            UserAction[]
  coachSessions         CoachSession[]
  pushSubscriptions     PushSubscription[]

  // Relationship Graph (New)
  organizations            Organization[]
  professionalTeams        ProfessionalTeam[]

  // Work Co-pilot (New)
  goals                 Goal[]
  conversationState     ConversationState?
  proactivePrompts      ProactivePrompt[]
  preferences           UserPreferences?
  chatMessages          Message[]
  conversations         Conversation[]
  intelligence          UserIntelligence?

  // Knowledge Graph
  knowledgeEntities     KnowledgeEntity[]
  knowledgeFacts        KnowledgeFact[]
  knowledgeCommunities  KnowledgeCommunity[]
  extractionLogs        ExtractionLog[]

  // Google API Watch Channels
  watchChannels         WatchChannel[]

  // WhatsApp Integration
  whatsAppSession       WhatsAppSession?
  whatsAppGroups        WhatsAppGroup[]
  whatsAppMessages      WhatsAppMessage[]

  professionalProjects     ProfessionalProject[]
  stakeholderRelationships StakeholderRelationship[]
  strategicObjectives      StrategicObjective[]
  githubInstallations      GitHubInstallation[]
  toolUseRecords           ToolUseRecord[]
  pinnedSources            PinnedSource[]

  // Meeting Champion
  meetingCommitments       MeetingCommitment[]
  meetingPatternSnapshots  MeetingPatternSnapshot[]

  // Ground Game
  influencePlans           InfluencePlan[]

  // Learning from corrections
  corrections              UserCorrection[]

  // Structured onboarding
  onboardingProgress       Json      @default("{}")  // { profile, role, outcomes, stakeholders, calendar, context }
  preferredChannel         String?                    // 'voice' | 'text'
  responsibilities         UserResponsibility[]
  uploadedDocuments        UploadedDocument[]
  voiceCalls               VoiceCall[]
  personalContext          PersonalContext?
  pendingNudges            PendingNudge[]
  scheduledCalls           ScheduledCall[]
  voiceOnboarding          OnboardingProgress?
  callFeedback             CallFeedback[]

  // Coaching Intelligence
  callEvaluations          CallEvaluation[]
  coachingRelationshipPlan CoachingRelationshipPlan?
  coachingTrajectories     CoachingTrajectory[]
  personalThreads          PersonalThread[]
  coachingExperiments      CoachingExperiment[]
  promptInsights           PromptInsight[]
  agentRuns                AgentRun[]
  hypotheses               Hypothesis[]
}

enum CompanyStage {
  SEED
  SERIES_A
  SERIES_B
  SERIES_C_PLUS
  GROWTH
  PUBLIC
}

model BusinessContext {
  id                    String   @id @default(cuid())
  userId                String   @unique

  // Core business understanding
  businessModel         String?                    // "B2B SaaS", "Marketplace"
  primaryMetric         String?                    // "ARR", "GMV", "DAU"
  currentChallenges     String[]                   // Top 3 challenges
  strategicPriorities   String[]                   // Company-level priorities

  // Org context
  teamSize              Int?
  directReports         Int?
  reportingTo           String?                    // "CEO", "CTO", "COO"
  peerVPs               String[]                   // Other VP relationships

  // Learned over time
  decisionPatterns      Json?                      // How user typically decides
  communicationStyle    String?                    // "Direct", "Collaborative"
  blindSpots            String[]                   // Identified through interactions
  strengths             String[]                   // Identified through interactions

  // Industry/company specifics
  competitors           String[]
  keyCustomerSegments   String[]
  regulatoryContext     String?
  
  // Knowledge Base
  knownRevenueDrivers   Json?                      // Learned context
  knownCostDrivers      Json?
  
  user                  User     @relation(fields: [userId], references: [id])

  updatedAt             DateTime @updatedAt
}

// Personal context — user-controlled. User decides what Mira remembers about them personally.
// Work context (BusinessContext, stakeholders, etc.) is always saved.
// Personal context is opt-in per item and visible/editable/deletable by user.
model PersonalContext {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // User-controlled personal data (each can be null = not shared yet)
  energyPatterns        String?                    // "Morning person", "Recharges with running"
  interests             String[]                   // Non-work interests, hobbies
  stressSignals         String?                    // "First thing to slip is email responses"
  values                String[]                   // "Won't compromise on team autonomy"
  personalWins          Json?                      // Recent non-work wins user shared
  preferredCallStyle    String?                    // "Brief and direct" vs "likes to chat"
  humorReceptivity      String?  @default("unknown") // "high", "moderate", "low", "unknown"
  commuteInfo           String?                    // "30 min drive", "works from home"

  // Relationship with Mira
  callCount             Int      @default(0)       // Total voice calls
  totalCallMinutes      Int      @default(0)       // Total minutes on calls
  firstCallDate         DateTime?                  // When they first called
  lastCallDate          DateTime?                  // Most recent call
  favoriteCallTypes     String[]                   // Which call types they engage with most

  // What Mira knows vs doesn't (for Honest Mirror dashboard)
  knownTopics           String[]                   // Topics Mira has good context on
  gapTopics             String[]                   // Topics Mira needs to learn about

  updatedAt             DateTime @updatedAt
}

model UserResponsibility {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title           String                     // Role title e.g. "VP Engineering"
  scope           String?  @db.Text          // What they own — narrative
  responsibilities String[]                  // Key responsibilities
  kpis            String[]                   // What they're measured on
  successCriteria String[]                   // What "great" looks like
  reportsTo       String?                    // Manager name/title
  teamSize        Int?

  // Business outcomes this role drives
  businessOutcomes Json     @default("[]")   // [{ title, metric, timeframe }]

  // Inference tracking
  inferred        Boolean  @default(true)    // LLM-generated
  confirmedAt     DateTime?                  // User reviewed & confirmed
  source          String   @default("inference") // inference, manual, document

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

model UploadedDocument {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  filename    String
  blobUrl     String                        // Vercel Blob URL
  mimeType    String
  sizeBytes   Int
  purpose     String   @default("context")  // context, role_doc, org_chart, other
  parsed      Boolean  @default(false)
  parsedData  Json?                         // Extracted structured data

  createdAt   DateTime @default(now())

  @@index([userId])
}

// Voice calls with Mira (via Vapi)
model VoiceCall {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  vapiCallId      String?  @unique   // Vapi's call ID
  callType        String              // pre_meeting_prep, morning_brief, post_meeting_debrief, general, etc.
  direction       String   @default("outbound") // inbound, outbound, web
  status          String   @default("queued")   // queued, ringing, in-progress, ended, failed
  meetingId       String?             // Linked meeting if applicable
  meeting         MeetingSyncRecord? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  // Call data
  durationSeconds Int?
  transcript      String?  @db.Text
  summary         String?  @db.Text
  recordingUrl    String?

  // Extracted insights
  keyTakeaways    Json?    // Array of strings
  commitments     Json?    // Action items captured from the call
  outcomeSet      String?  // If user stated a meeting outcome during the call

  // Observation (what was sent + what happened)
  promptTemplateName    String?              // Which prompt template was used
  promptTemplateVersion Int?                 // Version of the template
  configVersion         Int?                 // ConversationConfig version used
  assembledPrompt       String?  @db.Text    // Full system prompt sent to Vapi
  sentVariables         Json?                // Variable values sent to Vapi
  firstMessageSent      String?              // Which first message opener was used

  // Conversation engine signals
  confidenceMode        String?              // LEARNING, OBSERVING, COACHING
  adaptationSignals     Json?                // Signals detected during this call
  postCallExtraction    Json?                // Thread + confidence extraction results

  // Coaching Intelligence
  evaluation             CallEvaluation?
  experimentAssignments  ExperimentAssignment[]

  // Tool use tracking
  toolUseRecords         ToolUseRecord[]

  startedAt       DateTime @default(now())
  endedAt         DateTime?

  @@index([userId])
  @@index([vapiCallId])
  @@index([meetingId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Work Feedback System - Data Connectors linked to this OAuth account
  dataConnectors DataConnector[]

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================================
// THE CONTENT ENGINE (CMS)
// ============================================================================

// ============================================================================
// SKILLS & CURRICULUM
// ============================================================================

model Skill {
  id          String  @id @default(cuid())
  slug        String  @unique // e.g., "emotional-regulation"
  name        String
  cluster     String // e.g., "Self-Leadership"
  description String?

  userSkills UserSkill[]
  missions   Mission[]
}

model UserSkill {
  id      String @id @default(cuid())
  userId  String
  skillId String
  user    User   @relation(fields: [userId], references: [id])
  skill   Skill  @relation(fields: [skillId], references: [id])

  level      Float @default(0) // 0.0 - 5.0 Mastery
  confidence Float @default(0) // 0.0 - 1.0 (Evidence weight)

  // History of updates (delta logging could be done here or in separate table)
  lastUpdated DateTime @default(now())

  @@unique([userId, skillId])
}

// ============================================================================
// THE CONTENT ENGINE (CMS)
// ============================================================================

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Case {
  id          String  @id @default(cuid())
  slug        String  @unique // e.g., 'png-digital-id'
  title       String
  description String?

  // Curriculum Metadata
  isCore  Boolean @default(false) // 80% Rule
  cluster String? // Primary cluster e.g. "Strategy"
  skills  Json? // Array of Skill Slugs targeted e.g. ["reframing", "legacy-code"]
  
  // Antigravity Taxonomy
  vertical      CaseVertical     @default(GENERAL)
  horizontals   CaseHorizontal[]
  targetRoles   String[]         // ["VP", "EM", "DIRECTOR", "C_SUITE"]
  situations    String[]         // Trigger tags: ["reorg", "difficult_conversation", "board_prep"]
  complexity    CaseComplexity   @default(INTERMEDIATE)
  durationMins  Int              @default(15)
  
  triggerKeywords String[]       // For search/matching

  surfacings    CaseSurfacing[]

  versions CaseVersion[]

  // Pointer to the currently live version
  currentVersionId String?      @unique
  currentVersion   CaseVersion? @relation("LiveVersion", fields: [currentVersionId], references: [id])

  // Source Grounding (Provenance)
  sourceUrl String?
  factSheet Json? // Extracted facts from Ingestion Agent

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relation to ingestion pipeline
  generatedFrom IngestedArticle?

  // Recommendations linking to this case
  actionPlans UserActionPlan[]
}

model CaseVersion {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id])

  version Int // Incremental version number
  status  PublishStatus @default(DRAFT)

  // The "Blob" - contains Rounds, Prompts, Stakeholders, and Rubrics
  content Json

  changeLog String?

  createdAt DateTime @default(now())
  createdBy String // Curator ID (User)

  // Reverse relation for the live pointer
  liveFor Case? @relation("LiveVersion")

  @@unique([caseId, version])
}

model IngestedArticle {
  id      String  @id @default(cuid())
  url     String  @unique
  title   String?
  content String? @db.Text
  status  String // PENDING, PROCESSED, REJECTED, CONVERTED

  generatedCaseId String? @unique
  generatedCase   Case?   @relation(fields: [generatedCaseId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// STUDENT PROGRESS & ACCOUNTABILITY
// ============================================================================

model CaseProgress {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  caseId String // FK to Case

  completed Boolean @default(false)
  score     Int? // 0-100 overall performance

  // Granular data
  feedback Json? // AI Coaching summary
  rounds   Json? // What did they type in each round?

  // Evidence for Skill Graph
  skillDelta Json? // { "emotional-regulation": +0.2, "assertiveness": -0.1 }

  startedAt   DateTime  @default(now())
  completedAt DateTime?
}

model RecPlan {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  // The plan
  queue Json // Array of CaseSlugs ordered e.g. ["case-1", "case-2"]

  // 80/20 Audit
  coreCount     Int
  electiveCount Int
  justification String @db.Text
}

// ============================================================================
// RECOMMENDATION & REFLECTION ENGINE (NEW)
// ============================================================================

enum RecommendationStatus {
  PENDING
  COMMITTED
  COMPLETED
  SKIPPED
  DISMISSED
}

model UserActionPlan {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  capacity String 
  type     FeedbackType 

  // Evidence
  evidenceObservation String? @map("evidence_observation") @db.Text
  evidenceBenchmark   String? @map("evidence_benchmark") @db.Text

  // The prescription
  actionSummary String   @map("action_summary") @db.Text
  actionBullets Json     @map("action_bullets") 

  // Anchors
  targetMeetingId String?  @map("target_meeting_id")
  
  relatedCaseId   String?  @map("related_case_id")
  relatedCase     Case?    @relation(fields: [relatedCaseId], references: [id])

  // State
  status      RecommendationStatus @default(PENDING)
  committedAt DateTime?            @map("committed_at")
  completedAt DateTime?            @map("completed_at")

  // Link to reflection
  reflections Reflection[]

  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime? @map("expires_at")

  // Metadata
  metadata Json?

  @@index([userId, status])
  @@index([createdAt])
}

model Reflection {
  id               String @id @default(cuid())
  userId           String
  user             User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relations
  actionPlanId String?
  actionPlan   UserActionPlan? @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)
  
  recommendationId String? // Keeping for legacy if needed/migration safety.

  caseId           String? // Legacy/Content link

  meetingId        String? @map("meeting_id")

  // User input
  didPractice      Boolean? @map("did_practice") // Optional for general reflections
  userNotes        String? @map("user_notes") @db.Text

  // AI-assisted
  aiObservations         Json?   @map("ai_observations")
  aiObservationsAccuracy String? @map("ai_observations_accuracy")

  // Legacy fields support
  content      String?   @db.Text
  qualityScore Int?
  debtCleared  Boolean   @default(true)
  structuredData Json?

  // Metadata
  promptedAt   DateTime? @map("prompted_at")
  respondedAt  DateTime? @map("responded_at")
  responseTime Int?      @map("response_time")

  createdAt    DateTime  @default(now()) @map("created_at")
}

// ============================================================================
// REAL WORLD CONTEXT (INTEGRATIONS)
// ============================================================================

model UserProject {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  name        String
  description String?
  driveLink   String? // URL to GDrive folder/doc

  // AI Analysis of the project
  risks  Json? // ["Stakeholder Misalignment", "Tech Debt"]
  status String? // AI perception: "At Risk", "Healthy"

  // User corrections
  userNotes String?

  meetings MeetingLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  missions     Mission[]
  healthChecks ProjectHealth[]
}

model MeetingLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  projectId String? // Optional link to project
  project   UserProject? @relation(fields: [projectId], references: [id])

  date   DateTime
  source String // "GCal", "Upload"
  notes  String // Raw text

  analysis Json // { risks: [], clarity: 0-5 }

  createdAt DateTime @default(now())
}

model Mission {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  projectId String?
  project   UserProject? @relation(fields: [projectId], references: [id])

  skillId String // Link to Skill being applied
  skill   Skill  @relation(fields: [skillId], references: [id])

  title       String
  description String?
  status      String  @default("PLANNED") // PLANNED, IN_PROGRESS, COMPLETED, VERIFIED

  outcome        String? // User reflection
  aiVerification String? // AI analysis

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectHealth {
  id        String      @id @default(cuid())
  projectId String
  project   UserProject @relation(fields: [projectId], references: [id])

  ragStatus   String // RED, AMBER, GREEN
  pivotSignal Boolean @default(false)
  advice      String

  createdAt DateTime @default(now())
}

// ============================================================================
// SUBSCRIPTION & BILLING
// ============================================================================

enum SubscriptionTier {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
}

model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tier         SubscriptionTier   @default(FREE)
  status       SubscriptionStatus @default(ACTIVE)
  userCategory String             @default("customer") // internal, premium_lead, customer

  // Stripe Integration
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?

  // Razorpay Integration
  razorpaySubscriptionId String?   @unique
  razorpayPlanId         String?
  razorpayCustomerId     String?

  // Usage Limits
  monthlyCaseLimit        Int      @default(3) // FREE: 3, PRO: unlimited, ENTERPRISE: unlimited
  monthlyAiFeedbackLimit  Int      @default(0) // FREE: 0, PRO: 50, ENTERPRISE: unlimited
  casesUsedThisMonth      Int      @default(0)
  aiFeedbackUsedThisMonth Int      @default(0)
  lastResetDate           DateTime @default(now())

  // Features (legacy - will be replaced by feature flags)
  hasGoogleIntegrations Boolean @default(false) // PRO+
  hasAiFeedback         Boolean @default(false) // PRO+
  hasAgenticCoach       Boolean @default(false) // ENTERPRISE
  hasTeamFeatures       Boolean @default(false) // ENTERPRISE

  // Token-Based Metering (SaaS 2-tier)
  monthlyTokenLimit   Int      @default(0)        // 0 = BYOLLM (no platform LLM), 5000000 = 5M for Pro
  tokensUsedThisMonth BigInt   @default(0)
  tokenResetDate      DateTime @default(now())     // Aligned with Stripe billing cycle
  llmSource           String   @default("byollm")  // "byollm" | "platform"

  // Feature Flags (new system)
  enabledFeatures  String[] @default([]) // Override: enable features not in tier
  disabledFeatures String[] @default([]) // Override: disable features in tier

  // Trial
  trialEndsAt DateTime?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserApiKey {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider     String // "openai", "anthropic"
  keyPreview   String // First few characters for display (e.g., "sk-proj...")
  encryptedKey String @db.Text // Encrypted with app secret

  isActive Boolean   @default(true)
  lastUsed DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, provider])
}

model Payment {
  id     String @id @default(cuid())
  userId String

  stripePaymentId    String?  @unique
  razorpayPaymentId  String?  @unique
  gateway            String   @default("stripe") // "stripe" | "razorpay"
  amount             Int // In smallest unit (cents for USD, paise for INR)
  currency           String   @default("usd")
  status             String // succeeded, pending, failed

  description String?
  receiptUrl  String?

  createdAt DateTime @default(now())
}

// ============================================================================
// WORK FEEDBACK SYSTEM - CONNECTORS
// ============================================================================

enum ConnectorType {
  EMAIL
  CALENDAR
  DOCUMENTS
  NOTES
  MANUAL
  MCP
  WHATSAPP
  GITHUB
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  SYNCING
  PAUSED
}

model DataConnector {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type     ConnectorType
  provider String // gmail, gcal, gdrive, apple_notes, notion, manual

  status ConnectionStatus @default(DISCONNECTED)

  // OAuth credentials (references existing Account model for Google OAuth)
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])

  // MCP configuration (for Claude Cowork)
  mcpConfig Json? // MCP-specific settings

  // Sync settings
  syncFrequency  Int       @default(60) // minutes
  lastSyncAt     DateTime?
  lastSyncStatus String?

  // Permissions
  permissions Json @default("{}") // granular permissions

  // Artifact relation
  artifacts WorkArtifact[]

  // Project resources using this connector
  projectResources ProjectResource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, provider])
  @@index([userId])
}

// ============================================================================
// WORK FEEDBACK SYSTEM - ARTIFACTS
// ============================================================================

enum ArtifactType {
  EMAIL_SENT
  EMAIL_RECEIVED
  EMAIL_THREAD
  MEETING_ATTENDED
  MEETING_NOTES
  DOCUMENT_AUTHORED
  DOCUMENT_EDITED
  VOICE_NOTE
  TEXT_NOTE
  QUICK_REFLECTION
  STRUCTURED_REFLECTION
  PROJECT_UPDATE
  CONTEXT_TEACHING
  GITHUB_PR
  GITHUB_ISSUE
  GITHUB_COMMIT
}

model WorkArtifact {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  connectorId String
  connector   DataConnector @relation(fields: [connectorId], references: [id])

  type       ArtifactType
  externalId String? // ID in source system

  // Content
  title      String?
  content    String? @db.Text
  rawContent String? @db.Text // Original before processing

  // Metadata
  metadata     Json // Source-specific metadata
  participants Json? // People involved

  // Timestamps
  occurredAt DateTime // When artifact happened
  ingestedAt DateTime @default(now())

  // Analysis
  analyzed       Boolean @default(false)
  analysisResult Json?

  // Meeting Notes Linking
  linkedNoteId String? // Points to related note artifact (for meetings)
  linkedNote   WorkArtifact?  @relation("MeetingNotes", fields: [linkedNoteId], references: [id], onDelete: SetNull)
  meetingFor   WorkArtifact[] @relation("MeetingNotes")

  // Graph Relations (Antigravity Graph Builder)
  outgoingLinks ArtifactLink[] @relation("SourceArtifact")
  incomingLinks ArtifactLink[] @relation("TargetArtifact")

  // Evidence extraction
  observations SkillObservation[]
  
  // Antigravity: Conversation Prep Link
  conversationPreps ConversationPrep[]

  @@index([userId, type, occurredAt])
  @@index([connectorId])
  @@index([linkedNoteId])
}

enum LinkType {
  TIME_PROXIMITY
  CONTEXT_OVERLAP
  FOLLOW_UP
  PRE_READ
  TOPIC_CLUSTER
  EXPLICIT_MENTION
  MANUAL
}

model ArtifactLink {
  id        String   @id @default(cuid())
  sourceId  String
  targetId  String
  type      LinkType
  score     Float    @default(0.0) // 0.0 - 1.0
  metadata  Json?    // e.g. { "reason": "Same participants", "timeDiff": 120 }
  
  createdAt DateTime @default(now())

  source    WorkArtifact @relation("SourceArtifact", fields: [sourceId], references: [id], onDelete: Cascade)
  target    WorkArtifact @relation("TargetArtifact", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId])
  @@index([sourceId])
  @@index([targetId])
}

