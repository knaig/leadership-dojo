  // What was corrected
  entityType  String   // "meeting_classification", "stakeholder_archetype", "stakeholder_org", "outcome_suggestion"
  entityId    String?  // ID of the meeting/stakeholder/etc.

  // The AI's original prediction vs what user chose
  field       String   // "meetingCategory", "importance", "personaArchetype", etc.
  aiValue     String?  // What AI predicted
