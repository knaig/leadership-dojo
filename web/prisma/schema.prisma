// ============================================================================

model Capacity {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String @db.Text
  whyAIProof  String @db.Text

  // Related courses (slugs)
  courses String[]

  observations SkillObservation[]
  scores       CapacityScore[]
  practiceMissions PracticeMission[]
}

enum ObservationType {
  POSITIVE // Capacity demonstrated well
  NEGATIVE // Capacity demonstrated poorly
  MISSED_OPPORTUNITY // Could have applied but didn't
  NEUTRAL // Present but unremarkable
}

enum Severity {
  HIGH // Significant impact
  MEDIUM // Moderate impact
  LOW // Minor impact
}

model SkillObservation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Link to capacity (the 6 core capacities)
  capacityId String
  capacity   Capacity @relation(fields: [capacityId], references: [id])

  // Link to artifact that generated this observation
  artifactId String?
  artifact   WorkArtifact? @relation(fields: [artifactId], references: [id])

  // Observation details
  type        ObservationType
  context     String          @db.Text // What was happening
  observation String          @db.Text // What was observed
  evidence    String          @db.Text // Specific quote or description

  // Scoring
  score      Float // -1.0 to 1.0 (negative = gap, positive = strength)
  confidence Float // 0.0 to 1.0
  severity   Severity // How significant

  // User feedback
  userAgreed   Boolean?
  userFeedback String?  @db.Text
  userContext  String?  @db.Text // Context user added

  createdAt DateTime @default(now())

  @@index([userId, capacityId, createdAt])
  @@index([artifactId])
}

enum TrendDirection {
  IMPROVING
  STABLE
  DECLINING
  INSUFFICIENT_DATA
}

model CapacityScore {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  capacityId String
  capacity   Capacity @relation(fields: [capacityId], references: [id])

  // Current score
  score      Float // 0.0 to 5.0 (mastery scale)
  confidence Float // 0.0 to 1.0
  trend      TrendDirection @default(INSUFFICIENT_DATA)

  // Evidence counts
  positiveCount Int @default(0)
  negativeCount Int @default(0)
  missedCount   Int @default(0)

  lastObservation DateTime?
  updatedAt       DateTime  @updatedAt

  @@unique([userId, capacityId])
}

