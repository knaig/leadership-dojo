enum GoalMagnitude {
  CAREER
  QUARTERLY
  PROJECT
  TASK
}

enum GoalStatus {
  NASCENT
  ACTIVE
  BLOCKED
  ACHIEVED
  ABANDONED
}

// Goals - user's strategic objectives
model Goal {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  description     String
  magnitude       GoalMagnitude    @default(QUARTERLY)
  deadline        DateTime?
  status          GoalStatus       @default(ACTIVE)
  context         Json             @default("{}")  // Strategic insights

  stakeholders    GoalStakeholder[]
  actions         RelationshipAction[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum StakeholderRole {
  DECISION_MAKER
  INFLUENCER
  BLOCKER
  ALLY
  BRIDGE
  UNKNOWN
}

enum StakeholderImportance {
  MUST_HAVE
  NICE_TO_HAVE
}

enum RelationshipState {
  STRONG
  ADEQUATE
  WEAK
  NONE
  NEGATIVE
}

// Who matters for each goal
model GoalStakeholder {
  id              String   @id @default(cuid())
  goalId          String
  goal            Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  
  stakeholderId   String
  stakeholder     StakeholderProfile @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)

  role            StakeholderRole      @default(UNKNOWN)
  importance      StakeholderImportance @default(MUST_HAVE)
  currentState    RelationshipState    @default(NONE)
  requiredState   RelationshipState    @default(ADEQUATE)
  notes           String[]             

  @@unique([goalId, stakeholderId])
}

enum ConversationMode {
  GENERAL
  GOAL_CAPTURE
  STAKEHOLDER_MAPPING
  GAP_ANALYSIS
  STRATEGY
  EXECUTION
}

enum ConversationChannel {
  OUTCOMES          // Goal-driven thinking
  DEVILS_ADVOCATE   // AI takes opposite stance
  SKILL_BUILDING    // Practice hard conversations, role-play
  PERSONAL          // Private, never surfaced elsewhere
  GENERAL           // Default catch-all
}

model Conversation {
  id       String              @id @default(cuid())
  userId   String
  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel  ConversationChannel @default(GENERAL)
  title    String?
  isActive Boolean             @default(true)

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, channel])
  @@index([userId, updatedAt])
}

// Chat messages (shared with web app)
model Message {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role    String // "user", "assistant", "system"
  content String @db.Text

  type String @default("TEXT") // "TEXT", "PROACTIVE_NUDGE", "CONTEXT_UPDATE"

  // Metadata for nudges
  contextId String? // ID of the artifact/meeting triggering the nudge

  // Link to conversation channel (optional — legacy messages have no conversation)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])

  // Tool use tracking
  toolUseRecords ToolUseRecord[]

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([conversationId])
}

// Track conversation focus
model ConversationState {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  activeGoalId         String?
  activeStakeholderId  String?
  activeActionId       String?
  
  mode                 ConversationMode  @default(GENERAL)
  pendingDraft         Json?
  pendingAction        Json?
  
  updatedAt            DateTime @updatedAt
}

enum RelationshipActionType {
  BUILD
  STRENGTHEN
  REPAIR
  ACTIVATE
  MAINTAIN
}

enum RelActionStatus {
  NOT_STARTED
  IN_PROGRESS
  AWAITING_APPROVAL
  COMPLETED
}

model RelationshipAction {
  id              String   @id @default(cuid())
  goalId          String
  goal            Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  
  stakeholderId   String
  // No direct relation to stakeholder profile to allow flexibility
  
  type            RelationshipActionType
  description     String
  status          RelActionStatus @default(NOT_STARTED)
  
  steps           Json @default("[]")
  draftMessages   Json?
  
  dueDate         DateTime?
  completedAt     DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum PromptType {
  MORNING_BRIEF
  COACHING_BRIEF
  OPPORTUNITY
  EXECUTION_NUDGE
  REFLECTION
  CONTEXT_DEEPENING
}

model ProactivePrompt {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type            PromptType
  content         String   @db.Text
  
  goalId          String?
  stakeholderId   String?
  
  deliveredVia    String   @default("web")
  deliveredAt     DateTime @default(now())
  
  responded       Boolean  @default(false)
  resultedInAction Boolean @default(false)
}

model UserPreferences {
  id                      String  @id @default(cuid())
  userId                  String  @unique
  user                    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  promptFrequency         Int     @default(4)
  quietHoursStart         String  @default("21:00")
  quietHoursEnd           String  @default("08:00")
  preferredChannel        String  @default("web")
  enableProactivePrompts  Boolean @default(true)
  enableExecution         Boolean @default(false)
  whatsappBriefs          Boolean @default(false)

  // DND & Smart Batching
  dndStart                String?                    // HH:MM format, e.g. "22:00"
  dndEnd                  String?                    // HH:MM format, e.g. "07:00"
  timezone                String?  @default("Asia/Kolkata")
  quietWeekends           Boolean  @default(true)
  batchNudges             Boolean  @default(false)   // If true, batch non-urgent nudges to morning brief
  maxCallsPerDay          Int?     @default(3)
  preferredCallWindows    Json?                      // Array of {start: "HH:MM", end: "HH:MM", label: string}

  // Daily Call Schedule
  dailyCallEnabled        Boolean  @default(false)   // True when user opts into voice
  dailyCallTime           String   @default("07:45") // HH:MM in user's timezone — fallback for no-meeting days

  // Per-user voice feature flags (admin-controlled)
  voiceAutoSchedule       Boolean  @default(false)   // Auto-schedule daily calls via cron
  voicePreMeetingPrep     Boolean  @default(false)   // Proactive pre-meeting prep calls
  voicePostMeetingDebrief Boolean  @default(false)   // Proactive post-meeting debrief calls
  voiceProactiveNudge     Boolean  @default(false)   // Pattern detection nudge calls
  voiceFridayRitual       Boolean  @default(false)   // Friday wind-down call
  voiceWeeklyReflection   Boolean  @default(false)   // Weekly reflection call
  dailyCallRetryAfterMin  Int      @default(60)      // Minutes to wait before retry if no answer
  dailyCallMaxRetries     Int      @default(1)       // Max retries per day

  // Calendar-aware scheduling (default mode)
  callScheduleMode        String   @default("calendar_aware") // calendar_aware | fixed_time
  meetingPrepLeadMinutes  Int      @default(15)      // Call N minutes before meetings (10-30)
  meetingPrepMinGap       Int      @default(12)      // Min gap between meetings to fit a call (minutes)

  // Multi-call schedule (for testing / early adopters)
  callFrequencyMinutes    Int?                        // null = once daily at dailyCallTime. e.g. 60 = every hour
  callWindowStart         String?                     // HH:MM — first call of the day (e.g. "10:00")
  callWindowEnd           String?                     // HH:MM — last call of the day (e.g. "19:00")
  testCallMaxDuration     Int?                        // Override maxDurationSeconds for test calls (seconds)

  // Conversation Engine
  preferredCallDuration   Int?     @default(10)       // Minutes
  callPacingStyle         String?  @default("balanced") // quick, balanced, deep, flexible
  conversationMode        String?                     // work_first, relationship_first, adaptive
  primaryArchetype        String?                     // operator, navigator, climber, founder, skeptic, reluctant, juggler, only_one, connector, returner, portfolio, community
  secondaryArchetype      String?
  adaptationSignals       Json?                       // { modeLean, precision, peopleHungry, personalOpen, frameworkSeeker, followMode, integratedLife }

  // Call Intelligence — learned per user
  postureReceptivity      Json?                       // { celebrate: 0.8, challenge: 0.3, ... } — learned from call outcomes
  fatigueProfile          Json?                       // { baseThreshold: 0.4, recoveryRate: 0.15 }

  // Connection surfacing — tracks when each provider was last suggested
  connectionSuggestionsShown Json?    // { "whatsapp": "2026-03-20", "slack": null }

  // KPI-gated coaching stage
  coachingStage              String?   @default("listener")  // listener, mirror, thought_partner, coach
  stageEnteredAt             DateTime?                        // when current stage was entered
  stageGateMetrics           Json?                            // snapshot of KPIs at last evaluation
  userInitiatedDepthCount    Int       @default(0)            // times user asked "what do you think?"
  userStatedStakeholderCount Int       @default(0)            // stakeholders user mentioned in conversation
}

// Scheduled calls — tracks daily calls, retries, callbacks, and onboarding calls
model ScheduledCall {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  scheduledFor    DateTime              // When to make the call (UTC)
  callType        String                // daily_checkin, onboarding, callback, retry, morning_brief, meeting_prep
  status          String   @default("pending") // pending, calling, completed, no_answer, cancelled, rescheduled
  retryOf         String?               // ID of the original ScheduledCall this is a retry for
  retryCount      Int      @default(0)  // How many retries have been attempted

  // Meeting prep link — which meeting this call preps for (null for non-prep calls)
  meetingId       String?               // Links to MeetingSyncRecord.id

  // What to cover in this call
  agenda          Json?                 // { onboardingTopics?: string[], briefingContext?: string, userRequest?: string }

  // Outcome tracking
  voiceCallId     String?               // Links to VoiceCall record once call is made
  completedAt     DateTime?
  outcome         String?               // "completed", "no_answer", "call_later", "busy"
  callbackTime    DateTime?             // If user said "call me later", when they want the callback

  // Signal-driven scheduling (call intelligence)
  primaryPosture     String?               // celebrate|uplift|prepare|advise|listen|nudge|challenge|connect|debrief
  secondaryPosture   String?
  triggerSignals     Json?                 // { dimension, type, strength, postureAffinity }[]
  callWorthiness     Float?               // 0-1 score that justified this call
  fatigueThreshold   Float?               // fatigue threshold applied when scheduling

  createdAt       DateTime @default(now())

  @@index([userId, status])
  @@index([scheduledFor, status])
  @@index([userId, scheduledFor])
  @@index([meetingId])
}

// Tracks what onboarding topics have been covered across calls.
// Organized in 3 layers: Person → Leader → Ambition.
// Mira gets to know the human first, the professional second.
model OnboardingProgress {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Layer 1: The Person — who are you beyond the title?
  coveredStory          Boolean @default(false)  // Their journey — how they got here, what shaped them
  coveredDrivesAndValues Boolean @default(false) // What motivates them, personal values, what they care about
  coveredLife           Boolean @default(false)  // Family, interests, outside work, energy sources

  // Layer 2: The Leader — how do you lead?
  coveredRole           Boolean @default(false)  // Responsibilities, scope, what they own
  coveredStakeholders   Boolean @default(false)  // Key people, relationships, dynamics
  coveredLeadershipStyle Boolean @default(false) // Decision-making, communication, conflict, work preferences

  // Layer 3: The Ambition — where are you going?
  coveredGoals          Boolean @default(false)  // What success looks like, KPIs, aspirations
  coveredChallenges     Boolean @default(false)  // Blockers, frustrations, what keeps them up
  coveredGrowth         Boolean @default(false)  // What they want to get better at, learning edges

  // Legacy (kept for backward compat, mapped into new layers)
  coveredWorkStyle      Boolean @default(false)  // → coveredLeadershipStyle
  coveredContext        Boolean @default(false)  // → coveredStory + coveredRole

  // Metadata
  totalOnboardingCalls  Int     @default(0)
  lastOnboardingCallAt  DateTime?
  onboardingComplete    Boolean @default(false)  // True when all 9 topics covered

  updatedAt       DateTime @updatedAt
}

// Post-call feedback — collected after every call via in-app prompt or next call
model CallFeedback {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  voiceCallId     String?               // Links to VoiceCall
  callType        String                // What kind of call this was
  promptVersion   String?               // Which prompt version was used

  // User feedback
  rating          Int?                  // 1-5 star rating
  tooLong         Boolean?              // Was the call too long?
  tooShort        Boolean?              // Too short?
  wasRelevant     Boolean?              // Was the content relevant?
  wasActionable   Boolean?              // Did it lead to action?
  verbatimFeedback String?  @db.Text    // Free-text feedback from user
  feedbackSource  String   @default("in_app") // "in_app", "voice", "auto" (sentiment)

  // Auto-detected signals (from call analysis)
  userEngagement  String?               // "high", "medium", "low" — based on response length/count
  callCompleted   Boolean  @default(true) // Did user stay for the whole call?
  userInitiated   Boolean  @default(false) // Did user ask follow-up questions?

  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([callType, promptVersion])
  @@index([createdAt])
}

// Prompt versions — tracks which prompt text is used for each call type
// Enables A/B testing and data-driven prompt evolution
model PromptVersion {
  id              String   @id @default(cuid())
  callType        String                // Which call type this prompt is for
  version         String                // Semantic version: "1.0", "1.1", "2.0"
  isActive        Boolean  @default(true)  // Currently in use?
  rolloutPercent  Int      @default(100)   // 0-100: for gradual rollout / A/B testing

  // Prompt content
  systemPrompt    String   @db.Text      // The system prompt template
  firstMessage    String   @db.Text      // The opening message template
  maxDuration     Int      @default(300)  // Max call duration in seconds

  // Performance metrics (updated by aggregation job)
  totalCalls      Int      @default(0)
  avgRating       Float?                 // Average user rating (1-5)
  avgDuration     Int?                   // Average call duration in seconds
  completionRate  Float?                 // % of calls where user stayed til end
  engagementRate  Float?                 // % of calls with high engagement

  // Metadata
  changeNote      String?               // Why this version was created
  createdAt       DateTime @default(now())
  retiredAt       DateTime?             // When this version was deactivated

  @@unique([callType, version])
  @@index([callType, isActive])
}

model PendingNudge {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  trigger         String                // ProactiveTrigger type
  content         String   @db.Text     // Generated nudge content
  priority        String   @default("normal") // "urgent" | "normal" | "low"
  context         Json?                 // Original trigger context (meetingId, goalId, etc.)

  delivered       Boolean  @default(false)
  deliveredAt     DateTime?
  batchedIntoId   String?              // ID of morning brief message this was included in

  createdAt       DateTime @default(now())

  @@index([userId, delivered])
  @@index([userId, createdAt])
}

// ============================================================================
// KNOWLEDGE GRAPH (Zep-style temporal graph + GraphRAG community detection)
// ============================================================================

enum KnowledgeEntityType {
  PERSON
  PROJECT
  TOPIC
  SKILL
  TEAM
  ORGANIZATION
  GOAL
  MEETING_SERIES
  DOCUMENT
}

enum FactSource {
  USER_STATED
  INFERRED_MEETING
  INFERRED_EMAIL
  INFERRED_DOCUMENT
  INFERRED_CHAT
  INFERRED_GITHUB
  SYSTEM_DERIVED
  MIGRATED
}

model KnowledgeEntity {
  id             String              @id @default(cuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           KnowledgeEntityType
  name           String
  nameNormalized String              // lowercase for dedup
  properties     Json                @default("{}")

  // Link to existing models (migration bridge)
  sourceModelType String?
  sourceModelId   String?

  subjectFacts         KnowledgeFact[]     @relation("SubjectEntity")
  objectFacts          KnowledgeFact[]     @relation("ObjectEntity")
  communityMemberships CommunityMember[]

  // Back-relation to unified Project model
  linkedProject        Project?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, type, nameNormalized])
  @@index([userId, type])
}

model EntityMergeCandidate {
  id             String    @id @default(cuid())
  userId         String
  sourceEntityId String    // The new/potentially duplicate entity
  targetEntityId String    // The existing entity it might match
  similarity     Float     // 0-1 score
  status         String    @default("pending") // pending, confirmed, rejected
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  @@index([userId, status])
  @@unique([sourceEntityId, targetEntityId])
}

model KnowledgeFact {
  id             String @id @default(cuid())
  userId         String
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The triple: subject -> predicate -> object
  subjectId      String
  subject        KnowledgeEntity  @relation("SubjectEntity", fields: [subjectId], references: [id], onDelete: Cascade)
  predicate      String           // "works_on", "reports_to", "has_strength", etc.
  objectEntityId String?
  objectEntity   KnowledgeEntity? @relation("ObjectEntity", fields: [objectEntityId], references: [id], onDelete: SetNull)
  objectValue    String?          // For literal values: "VP Engineering"

  // Bi-temporal tracking
  validFrom      DateTime @default(now())  // When fact became true
  validTo        DateTime?                 // When it stopped being true (null = current)
  recordedAt     DateTime @default(now())  // When we learned it

  // Provenance
  source         FactSource
  sourceRefType  String?   // "MeetingSyncRecord", "EmailSummary", "Message"
  sourceRefId    String?

  // Confidence & validity
  confidence     Float    @default(0.5)
  userVerified   Boolean?  // null=unverified, true=confirmed, false=denied
  supersedesId   String?
  supersedes     KnowledgeFact?  @relation("Supersession", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy   KnowledgeFact[] @relation("Supersession")
  metadata       Json?

  // Optional project scoping (hybrid approach)
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, subjectId])
  @@index([userId, predicate])
  @@index([subjectId, predicate, validTo])
  @@index([userId, source])
  @@index([userId, projectId])
}

model KnowledgeCommunity {
  id            String @id @default(cuid())
  userId        String
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  summary       String? @db.Text
  level         Int     @default(0) // 0=fine, 1+=abstract
  parentId      String?
  parent        KnowledgeCommunity?  @relation("CommunityHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children      KnowledgeCommunity[] @relation("CommunityHierarchy")
  entityCount   Int     @default(0)
  factCount     Int     @default(0)
  activityScore Float   @default(0)
  members       CommunityMember[]
  lastAnalyzedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, level])
}

model CommunityMember {
  id          String             @id @default(cuid())
  communityId String
  community   KnowledgeCommunity @relation(fields: [communityId], references: [id], onDelete: Cascade)
  entityId    String
  entity      KnowledgeEntity    @relation(fields: [entityId], references: [id], onDelete: Cascade)
  role        String?            // "hub", "bridge", "peripheral"
  weight      Float              @default(1.0)

  @@unique([communityId, entityId])
}

model ExtractionLog {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceType       String   // "MeetingSyncRecord", "EmailSummary", etc.
  sourceId         String
  entitiesFound    Int      @default(0)
  factsCreated     Int      @default(0)
  extractorVersion Int      @default(1)
  processedAt      DateTime @default(now())

  @@unique([userId, sourceType, sourceId, extractorVersion])
  @@index([userId, sourceType])
}

// ============================================================================
// WHATSAPP INTEGRATION
// ============================================================================

model WhatsAppSession {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  credentials String   @db.Text // baileys auth state JSON
  status      String   @default("DISCONNECTED") // CONNECTED, DISCONNECTED, QR_PENDING

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WhatsAppGroup {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  groupId          String   // WhatsApp JID (e.g., "120363XXX@g.us")
  groupName        String
  isActive         Boolean  @default(true) // User can deactivate monitoring
  participantCount Int      @default(0)

  messages         WhatsAppMessage[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, groupId])
  @@index([userId, isActive])
}

model WhatsAppMessage {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  groupId          String
  group            WhatsAppGroup @relation(fields: [userId, groupId], references: [userId, groupId])

  senderPhone      String
  senderName       String
  content          String   @db.Text
  messageTimestamp DateTime
  externalId       String   // WhatsApp message ID

  processed        Boolean  @default(false) // Has fact extraction run on this?

  createdAt        DateTime @default(now())

  @@index([userId, groupId, processed])
  @@index([userId, createdAt])
}

// ============================================================================
// CONVERSATION CONTROL PLANE
// ============================================================================

// Versioned prompt templates — editable from admin panel
model PromptTemplate {
  id                  String   @id @default(cuid())
  name                String   // e.g., "voice-pre-meeting", "voice-morning-brief", "chat-router"
  version             Int      @default(1)
  content             String   @db.Text    // Template text with {{variables}}
  firstMessageOptions Json?                // Array of first message variants
  variables           Json?                // Schema of expected variables: [{name, description, required}]
  maxDurationSeconds  Int?                 // Call duration for this prompt type
  status              String   @default("draft") // draft, active, archived
  notes               String?  @db.Text    // Why this version was created
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([name, version])
  @@index([name, status])
}

// Configurable conversation engine parameters
model ConversationConfig {
  id                   String   @id @default(cuid())
  version              Int      @default(1) @unique
  confidenceThresholds Json     // { default: {SILENT: 0, PROBE: 0.3, ...}, skeptic: {...} }
  adaptationRules      Json     // Signal definitions + weights
  maturityTransitions  Json     // Transition triggers (calls, stakeholders, confirmations)
  voiceOverrides       Json     // Speed, temp, silence rules per context/archetype
  guardrails           Json     // { closedWorldRules: string, banList: string[], specificityTest: string, personalRules: string }
  status               String   @default("draft") // draft, active, archived
  notes                String?  @db.Text
  createdAt            DateTime @default(now())
}

// Named experiments for comparing prompt/config variants
model Experiment {
  id                String   @id @default(cuid())
  name              String   // e.g., "call-1-opener-v2"
  hypothesis        String?  @db.Text
  promptTemplateName String?  // Which prompt to vary (null = config experiment)
  promptVersionA    Int?     // Control version
  promptVersionB    Int?     // Variant version
  configVersionA    Int?     // Control config
  configVersionB    Int?     // Variant config
  userAssignments   Json     // { "A": ["userId1"], "B": ["userId2"] }
  status            String   @default("active") // active, completed, cancelled
  startDate         DateTime @default(now())
  endDate           DateTime?
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
}

// ============================================================================
// COACHING INTELLIGENCE SYSTEM
// ============================================================================

// Post-call evaluation — one per VoiceCall
model CallEvaluation {
  id                    String   @id @default(cuid())
  voiceCallId           String   @unique
  voiceCall             VoiceCall @relation(fields: [voiceCallId], references: [id], onDelete: Cascade)
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 6 KPI scores (1-10)
  newGroundScore        Float             // Did Mira learn something new?
  depthOfSharingScore   Float             // How deeply did the user share?
  valueAddScore         Float             // Did Mira add value?
  contextUtilScore      Float             // Did Mira use available context well?
  repetitionScore       Float             // Inverse — lower = more repetition
  engagementScore       Float             // User engagement level

  // Weighted overall: valueAdd 0.25, newGround 0.2, depth 0.2, context 0.15, repetition 0.1, engagement 0.1
  overallScore          Float

  // Qualitative
  whatWorked            String[]          // Things that went well
  whatToImprove         String[]          // Suggestions for next time
  commitmentsExtracted  String[]          // Action items the user mentioned
  newInfoLearned        String[]          // New facts Mira learned
  recommendedTopics     String[]          // Topics for next call

  // Call Intelligence — posture + timing validation
  postureMatch          Float?            // 1-10: did the posture match the user's apparent need?
  timingMatch           Float?            // 1-10: was this a good time to call?
  selectedPosture       String?           // which posture was used for this call

  createdAt             DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// Coaching relationship plan — one per User
model CoachingRelationshipPlan {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Phase: discovery (1-5) → building_trust (6-15) → deep_coaching (16-30) → sustained_partnership (31+)
  phase                 String   @default("discovery")

  // Coaching themes — through-lines across calls
  // [{ theme, firstSeen, lastSeen, callCount, status: active|resolved|parked }]
  coachingThemes        Json     @default("[]")

  // Communication profile — how the user prefers to interact
  // { pace, depth, humor, directness, preferredTopicEntry, avoidPatterns }
  communicationProfile  Json     @default("{}")

  // Personality profile — Big 5, communication style, emotional triggers, decision style, coaching adaptations
  personalityProfile    Json     @default("{}")

  // Commitments — action items with tracking
  // [{ commitment, madeAt, followedUpAt?, status: open|followed_up|completed|dropped, callId }]
  commitments           Json     @default("[]")

  // Topics to avoid (user explicitly said don't bring up)
  avoidTopics           String[]

  updatedAt             DateTime @updatedAt

  @@index([phase])
}

// Weekly trajectory snapshots — KPI trends over time
model CoachingTrajectory {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  weekStart             DateTime

  // Trajectory KPIs
  avgCallQuality        Float?            // Avg overallScore for the week
  relationshipDepthRate Float?            // Rate of depth growth
  trustVelocity         Float?            // Speed of trust building
  knowledgeGraphGrowth  Float?            // New facts/entities added
  coachingActivationRate Float?           // % of suggestions acted on
  callRetentionRate     Float?            // % of scheduled calls completed
  onboardingVelocity    Float?            // Topics covered per call

  // Aggregates
  callsCompleted        Int      @default(0)
  totalMinutes          Int      @default(0)
  commitmentsTracked    Int      @default(0)
  commitmentsCompleted  Int      @default(0)

  createdAt             DateTime @default(now())

  @@unique([userId, weekStart])
  @@index([userId])
}

// Personal threads — topics tracked across calls (family, hobbies, career, etc.)
model PersonalThread {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  category        String              // FAMILY, HEALTH, HOBBY, ORIGIN, ASPIRATION, EMOTIONAL, INTEGRATED
  topic           String              // "tennis", "kids ages 7 and 4"
  stage           String   @default("PLANTED") // PLANTED, WATERED, GROWING, HARVESTED, MAINTAINED
  lastTouched     DateTime @default(now())
  touchCount      Int      @default(1)
  userEngagement  String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  details         Json?              // Accumulated context per call
  isIntegrated    Boolean  @default(false)  // Personal topic intertwined with work
  offLimits       Boolean  @default(false)  // User said don't bring it up

  createdAt       DateTime @default(now())

  @@index([userId, stage])
  @@index([userId, lastTouched])
}

// ============================================================================
// CONTROLLED A/B EXPERIMENTATION (per-user within-subject design)
// ============================================================================

model CoachingExperiment {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  dimension           String              // "opening_style", "question_density", "challenge_level", etc.
  hypothesis          String   @db.Text
  primaryKpi          String              // "depthOfSharingScore", "engagementScore", etc.
  secondaryKpis       String[]

  variantALabel       String
  variantAInstruction String   @db.Text
  variantBLabel       String
  variantBInstruction String   @db.Text

  // Lifecycle: proposed → active → concluded → archived
  status              String   @default("proposed")
  minCallsPerVariant  Int      @default(5)

  // Results
  variantACallCount   Int      @default(0)
  variantBCallCount   Int      @default(0)
  variantAAvgKpi      Float?
  variantBAvgKpi      Float?
  variantAScores      Float[]
  variantBScores      Float[]
  effectSize          Float?
  pValue              Float?
  winner              String?            // "A", "B", or "inconclusive"
  conclusion          String?  @db.Text

  activatedAt         DateTime?
  concludedAt         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  assignments         ExperimentAssignment[]

  @@unique([userId, dimension, status])
  @@index([userId, status])
  @@index([status])
}

model ExperimentAssignment {
  id                String   @id @default(cuid())
  experimentId      String
  experiment        CoachingExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  voiceCallId       String
  voiceCall         VoiceCall @relation(fields: [voiceCallId], references: [id], onDelete: Cascade)
  userId            String

  variant           String              // "A" or "B"
  instructionUsed   String   @db.Text

  primaryKpiScore   Float?
  overallScore      Float?

  createdAt         DateTime @default(now())

  @@index([experimentId, variant])
  @@index([userId])
}

// Auto-discovered prompt insights — the system learns what coaching strategies work
// and automatically feeds proven insights back into future calls.
model PromptInsight {
  id                    String   @id @default(cuid())

  // What was discovered
  pattern               String   @db.Text    // "Commitment follow-ups in first 2 min → 2x valueAddScore"
  recommendation        String   @db.Text    // Directive for Mira: "Open with commitment check when user has overdue commitments"
  category              String              // opening, topic_selection, tone, pacing, follow_up, commitment_tracking, personal_depth, context_use

  // Evidence
  evidenceBasis         Json                // { callsAnalyzed, avgScoreWith, avgScoreWithout, kpiAffected, sampleSize, effectSize }
  scope                 String              // "system" for all users, or a specific userId
  userId                String?             // null for system-wide insights
  user                  User?               @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Lifecycle: proposed → active → validated → retired
  status                String   @default("proposed")
  confidence            Float    @default(0)           // 0-1 based on evidence strength

  // Impact measurement
  activatedAt           DateTime?
  preActivateAvgScore   Float?              // avg overallScore across calls before activation
  postActivateAvgScore  Float?              // avg overallScore after activation (rolling)
  callsSinceActivation  Int      @default(0)
  impactDelta           Float?              // postActivateAvg - preActivateAvg

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([scope, status])
  @@index([userId, status])
  @@index([category, status])
}

// Agent observability — tracks every agent/cron run for health monitoring
model AgentRun {
  id              String    @id @default(cuid())
  agentName       String                        // "call-evaluation", "stakeholder-synthesis", etc.
  userId          String?                       // null for system-level jobs
  user            User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  triggerType     String                        // "cron", "event", "api", "queue"
  triggerRef      String?                       // cron name, queue name, or API path

  status          String    @default("running") // running, completed, failed, skipped
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  durationMs      Int?

  // What it did
  inputSummary    String?   @db.Text
  outputSummary   String?   @db.Text
  itemsProcessed  Int       @default(0)
  itemsSkipped    Int       @default(0)

  // Errors
  errorMessage    String?   @db.Text
  errorStack      String?   @db.Text

  // LLM usage
  llmCalls        Int       @default(0)
  tokensUsed      Int       @default(0)

  createdAt       DateTime  @default(now())

  @@index([agentName, status])
  @@index([agentName, startedAt])
  @@index([userId, agentName])
  @@index([status, startedAt])
}

// ============================================================================
// HYPOTHESIS ENGINE — observe → hypothesize → present → validate → learn
// ============================================================================

enum HypothesisStatus {
  PENDING        // Generated, not yet presented to user
  READY          // Queued for next call presentation
  PRESENTED      // Shown to user in a call
  CONFIRMED      // User confirmed (explicit or implicit)
  REVISED        // User corrected — generates a new hypothesis
  REJECTED       // User denied outright
  EXPIRED        // Too old or superseded, never presented
}

enum HypothesisCategory {
  STAKEHOLDER_DYNAMIC    // "Raj is your go-to for technical decisions"
  POWER_ASYMMETRY        // "You defer to Priya in emails — is she a key decision-maker?"
  COMMUNICATION_PATTERN  // "You tend to send longer emails to senior stakeholders"
  WORK_PRIORITY          // "Project X seems to be consuming most of your energy"
  LEADERSHIP_STYLE       // "You prefer consensus before making big calls"
  RELATIONSHIP_QUALITY   // "Your interaction with Rahul has dropped off this month"
  PERSONAL_INSIGHT       // "Tennis seems like your reset button"
  TEAM_DYNAMIC           // "Your 1:1s with direct reports are getting shorter"
  STRATEGIC_PATTERN      // "You spend 60% of time in ops, 10% in strategy"
}

enum HypothesisVisibility {
  USER        // Factual claims the user can see and validate ("Manmeet is your co-founder")
  ADMIN_ONLY  // Meta observations only admin sees ("User deflects with humor when uncomfortable")
}

model Hypothesis {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The hypothesis itself
  category        HypothesisCategory
  statement       String            @db.Text  // "Based on email patterns, Priya appears to be a more senior stakeholder"
  evidence        String            @db.Text  // "You sent 12 emails to Priya this week, avg 180 words. Her replies avg 40 words."
  confidence      Float             @default(0.5) // 0-1, how confident the system is
  presentationText String           @db.Text  // Natural language for Mira: "I notice you email Priya a lot — she seems important. What's that dynamic?"

  // Lifecycle
  status          HypothesisStatus  @default(PENDING)
  priority        Int               @default(5) // 1=highest, 10=lowest
  visibility      HypothesisVisibility @default(USER) // USER = facts to validate, ADMIN_ONLY = meta observations

  // Source tracking
  sourceType      String            // "email_analysis", "calendar_pattern", "call_transcript", "meeting_frequency"
  sourceRefId     String?           // Optional reference to specific record
  sourceData      Json?             // Raw data that generated this hypothesis

  // Presentation tracking
  presentedInCallId String?         // VoiceCall ID where this was presented
  presentedAt     DateTime?
  userResponse    String?           @db.Text  // What the user actually said

  // Validation outcome
  validatedAt     DateTime?
  revisedFromId   String?           // If this is a revision, link to original
  revisedFrom     Hypothesis?       @relation("HypothesisRevision", fields: [revisedFromId], references: [id])
  revisions       Hypothesis[]      @relation("HypothesisRevision")

  // Links to knowledge graph
  subjectEntityId String?           // KnowledgeEntity this is about
  relatedStakeholderId String?      // StakeholderProfile this is about

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([userId, status])
  @@index([userId, category])
  @@index([userId, status, priority])
}

// ============================================================================
// UNIFIED PROJECT MODEL (replaces UserProject + ProfessionalProject)
// ============================================================================

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

model Project {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String? @db.Text
  status      ProjectStatus @default(ACTIVE)

  // Org context
  orgId     String?
  org       Organization? @relation(fields: [orgId], references: [id])

  // Dates
  startDate DateTime?
  endDate   DateTime?

  // AI analysis
  risks       Json?
  healthScore String?
  userNotes   String? @db.Text

  // Knowledge graph bridge
  knowledgeEntityId String?          @unique
  knowledgeEntity   KnowledgeEntity? @relation(fields: [knowledgeEntityId], references: [id])

  // Relations
  objectives  StrategicObjective[] @relation("ProjectObjectives")
  resources   ProjectResource[]
  facts       KnowledgeFact[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, status])
}

// ============================================================================
// PROJECT RESOURCES — links external sources to projects
// ============================================================================

enum ProjectSourceType {
  DRIVE_FOLDER
  GITHUB_REPO
  SLACK_CHANNEL
  JIRA_PROJECT
  LINEAR_PROJECT
  NOTION_DATABASE
}

model ProjectResource {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  sourceType  ProjectSourceType
  connectorId String?
  connector   DataConnector? @relation(fields: [connectorId], references: [id])

  externalId String    // Drive folder ID, "owner/repo", Slack channel ID
  name       String    // Display name
  url        String?   // Web URL
  metadata   Json      @default("{}")

  lastSyncAt DateTime?
  syncStatus String?

  githubSyncRecords GitHubSyncRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, sourceType, externalId])
}

// ============================================================================
// GITHUB INTEGRATION
// ============================================================================

model GitHubInstallation {
  id             String @id @default(cuid())
  userId         String
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  installationId Int    @unique
  accountLogin   String
  accountType    String         // "Organization" or "User"
  permissions    Json
  repositorySelection String   // "all" or "selected"

  accessToken    String? @db.Text  // encrypted, short-lived
  tokenExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GitHubSyncRecord {
  id         String @id @default(cuid())
  userId     String
  resourceId String
  resource   ProjectResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  entityType String    // "pull_request", "issue", "commit"
  externalId String    // PR number, issue number, commit SHA
  title      String?
  content    String? @db.Text
  author     String?
  state      String?
  metadata   Json      @default("{}")
  occurredAt DateTime
  syncedAt   DateTime  @default(now())

  @@unique([resourceId, entityType, externalId])
  @@index([userId])
}

// ============================================================================
// TOOL USE RECORDING — persists tool invocations from calls and chat
// ============================================================================

enum ToolUseSource {
  VOICE_CALL
  CHAT
}

model ToolUseRecord {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Source context
  source       ToolUseSource
  voiceCallId  String?
  voiceCall    VoiceCall? @relation(fields: [voiceCallId], references: [id])
  messageId    String?
  message      Message?   @relation(fields: [messageId], references: [id])

  // Tool details
  toolName     String
  intent       String?              // raw intent string (for voice)
  inputData    Json      @default("{}")
  outputData   Json      @default("{}")
  success      Boolean   @default(true)
  errorMessage String?
  durationMs   Int?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, toolName])
  @@index([voiceCallId])
}

// ═══════════════════════════════════════════════════════
// PINNED SOURCES
// User-selected Drive folders/docs for permanent monitoring.
// Default: last 90 days rolling window.
// Pinned sources bypass the 90-day window — always synced and extracted.
// ═══════════════════════════════════════════════════════

model PinnedSource {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sourceType  String    // "drive_folder", "drive_doc", "email_label"
  externalId  String    // Google Drive folder/file ID, Gmail label ID
  name        String    // Display name ("AI4Inclusion Proposal", "Q1 Strategy Folder")
  description String?   // Optional user note about why this is pinned

  lastSyncedAt DateTime?
  syncStatus   String   @default("pending") // pending, syncing, synced, error

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, sourceType, externalId])
  @@index([userId])
}

// ============================================================================
// SYSTEM ALERTS
// ============================================================================

model SystemAlert {
  id          String   @id @default(cuid())
  type        String                           // API_KEY_HEALTH, SYSTEM_ERROR, etc.
  severity    String   @default("WARNING")     // WARNING, CRITICAL
  title       String
  message     String
  metadata    Json?
  resolved    Boolean  @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([type, resolved])
  @@index([createdAt])
}
