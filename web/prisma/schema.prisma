// --- SYNC STATUS TRACKING ---

model SyncStatus {
  id          String    @id @default(cuid())
  userId      String
  connector   String    // 'calendar', 'email', 'drive'
  
  lastSyncAt  DateTime?
  lastError   String?
  status      String    @default("idle") // idle, syncing, error
  
  nextSyncAt  DateTime? // Scheduled next sync time
  syncCount   Int       @default(0)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@unique([userId, connector])
  @@index([userId])
}

// --- WATCH CHANNELS (Google Push Notifications) ---

model WatchChannel {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  connector   String    // 'calendar', 'drive', 'gmail'
  channelId   String    @unique   // UUID sent to Google
  resourceId  String?             // Google's resource ID (needed to stop channel)
  expiration  DateTime            // Channel expires (max 7 days)
  syncToken   String?             // For incremental sync (calendar/gmail)
  pageToken   String?             // For change tracking (drive)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([connector])
  @@index([expiration])
}

// --- MEETING SYNC RECORDS ---

model MeetingSyncRecord {
  id            String    @id @default(cuid())
  userId        String
  externalId    String    // Calendar event ID
  
  title         String
  description   String?   @db.Text
  startTime     DateTime
  endTime       DateTime
  attendees     Json      // Array of {email, name, response}
  location      String?
  
  // Event status
  status        String    @default("confirmed") // confirmed, cancelled, tentative
  isRecurring   Boolean   @default(false)
  recurringId   String?   // For recurring events
  
  // Conference / video call
  meetLink      String?   // Google Meet URL (e.g., https://meet.google.com/abc-xyz)
  conferenceId  String?   // Google Meet conference ID for dedup
  notesDocId    String?   // Google Drive doc ID of matched Gemini notes (cached after first match)

  // Extracted context
  meetingType   String?   // inferred: "1:1", "team", "external"
  meetingCategory MeetingCategory?  // NEEDLE_MOVER, OPERATIONAL, GROWTH, UNCLASSIFIED
  isPresentation  Boolean  @default(false) // User is presenting (organizer + large audience + keywords)
  participants  String[]  // Extracted email addresses

  // Outcome tracking (post-meeting)
  outcome       String?   @db.Text
  outcomeResult OutcomeResult?  // LANDED, PARTIAL, MISSED, SKIPPED
  notes         String?   @db.Text
  followUps     String[]

  // User classification overrides
  userImportanceOverride String?    // critical | high | medium | low — user can override Mira's classification
  strategicLevel         String?    // personal | team — whose strategy this meeting serves
  strategicOwner         String?    // Team member name (when strategicLevel = team)
  userNotes              String?    @db.Text  // Pre-meeting user comments/context for Mira

  // Meeting Lifecycle
  lifecycleStage    String?    // OUTCOME_ASKED | OUTCOME_SET | BRIEF_SENT | IN_PROGRESS | ENDED | REVIEWED
  desiredOutcome    String?    @db.Text
  outcomeSuggestions String[]  // AI-generated outcome suggestions for one-tap accept
  outcomeAskedAt    DateTime?
  briefSentAt       DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  conversationOutcome ConversationOutcome?
  commitments   MeetingCommitment[]
  voiceCalls    VoiceCall[]
  influencePlan InfluencePlan?

  @@unique([userId, externalId])
  @@index([userId, startTime])
  @@index([participants])
}

// Ground Game: Influence plan for high-stakes meetings
model InfluencePlan {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Target meeting
  meetingId         String   @unique
  meeting           MeetingSyncRecord @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  // Room assessment
  roomTemperature   Float    @default(0.5) // 0-1 confidence in meeting success
  roomRead          Json?    // [{stakeholderId, name, stance, influence, concerns, strategy}]
  tacticalAdvice    String?  @db.Text // LLM-generated one-liner tactical tip

  // Influence steps (sequenced actions)
  influenceSteps    Json?    // [{action, stakeholderId, status, dueDate, outcome}]
  suggestedMeetings Json?    // [{stakeholderId, name, reason, talkingPoints, status}]

  // Status
  status            String   @default("active") // active, completed, abandoned
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([meetingId])
}

enum MeetingCategory {
  NEEDLE_MOVER    // Strategy, decisions, key stakeholders
  TACTICAL        // Short-term goal execution, project milestones
  OPERATIONAL     // Standups, syncs, status updates
  GROWTH          // 1:1s with reports, mentoring, reviews
  UNCLASSIFIED    // Not enough signal
}

enum OutcomeResult {
  LANDED    // User achieved their desired outcome
  PARTIAL   // Partially achieved
  MISSED    // Did not achieve
  SKIPPED   // User dismissed/didn't respond
}

// --- MEETING COMMITMENTS ---

model MeetingCommitment {
  id          String    @id @default(cuid())
  meetingId   String
  meeting     MeetingSyncRecord @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  owner       String    // Who committed (person name)
  ownerEmail  String?   // Email if known
  description String    @db.Text  // What they committed to
  dueDate     DateTime? // By when

  status      CommitmentStatus @default(PENDING)
  fulfilledAt DateTime?
  reminderSentAt DateTime? // When we last reminded about this
  source      CommitmentSource @default(CHAT)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([meetingId])
}

enum CommitmentStatus {
  PENDING
  FULFILLED
  OVERDUE
  DROPPED
}

enum CommitmentSource {
  CHAT      // Extracted from post-meeting chat
  MANUAL    // User explicitly created
}

