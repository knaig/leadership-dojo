# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DIRECT_URL=postgresql://user:pass@host/db?sslmode=require

# Auth (Clerk)
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# LLM Providers (at least one required)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Encryption (for user API key storage)
ENCRYPTION_SECRET=

# Pusher (real-time updates)
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# Web Push (browser notifications)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Vapi (voice calls)
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
# Vapi Assistant IDs (created via scripts/setup-vapi-assistants.ts)
VAPI_ASSISTANT_ONBOARDING=
VAPI_ASSISTANT_DAILY=
VAPI_ASSISTANT_MEETING=

# Langfuse (LLM observability + prompt management — cloud.langfuse.com free tier)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Google OAuth (calendar/email/drive sync)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stakeholder Enrichment — web search providers (waterfall: Tavily → Perplexity → Google)
# Tavily: free 1000 searches/month — sign up at tavily.com
TAVILY_API_KEY=
# Perplexity Sonar: paid, ~$1-3/month — sign up at perplexity.ai/api-platform
PERPLEXITY_API_KEY=
# Google Custom Search: deprecated Jan 2027 — legacy fallback only
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Microsoft 365 Integration (calendar, email, OneDrive sync)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Dropbox (document sync)
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=

# Box (document sync)
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=

# Slack (messaging intelligence)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Zoom (meeting recordings + transcripts)
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Notion (project context — tokens don't expire)
# Configured via Notion integration: notion.so/my-integrations

# Linear (project management — GraphQL API)
# Uses OAuth or API key stored in Account table

# Jira (project management — Atlassian OAuth 3LO)
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# Trello (project management — API key + token)
TRELLO_API_KEY=

# Asana (project management — OAuth)
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=
